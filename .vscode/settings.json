{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.terminal.activateEnvironment": true,
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff", "editor.formatOnSave": false },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/.ruff_cache": true, "*.egg-info": true },
  "files.associations": { "render.yaml": "yaml", "Dockerfile.*": "dockerfile" },
  "yaml.schemas": { "https://render.com/schema/render.yaml.json": "render.yaml" },
  "files.eol": "\n"
}
