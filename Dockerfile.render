# Chrono Trade no Render (https://render.com): um serviço web com disco persistente em /data.
# O render.yaml (na raiz do repositório) já aponta para este arquivo.
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /build
COPY . .
RUN pip install --no-cache-dir .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    CHRONOTRADE_HOME=/data \
    CHRONOTRADE_MODO=servidor \
    TRADINGAGENTS_RESULTS_DIR=/data/tradingagents/logs \
    TRADINGAGENTS_CACHE_DIR=/data/tradingagents/cache
COPY --from=builder /opt/venv /opt/venv
WORKDIR /app
COPY --from=builder /build/.streamlit ./.streamlit
COPY --from=builder /build/deploy/render/iniciar.sh ./iniciar.sh
# O disco do Render é montado em /data na hora de rodar; o processo roda como root para poder gravar nele.
EXPOSE 10000
CMD ["sh", "./iniciar.sh"]
