# HTTPS automático para o Chrono Trade online.
# Aponte o domínio para o IP do servidor e defina CHRONOTRADE_DOMINIO no .env.
{$CHRONOTRADE_DOMINIO} {
    encode gzip
    # Conector do PC (MetaTrader 5 / Profit) fala com a API
    handle /api/* {
        reverse_proxy api:8502
    }
    handle {
        reverse_proxy chronotrade:8501
    }
}
