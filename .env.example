# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_BASE_URL=https://openrouter.ai/api   # Jev through OpenRouter, with an OpenRouter key above

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# --- Chrono Trade ---
# pessoal (padrão): só você usa, sem login.  servidor: online, com contas e assinaturas.
#CHRONOTRADE_MODO=pessoal
# Modo servidor: e-mail do administrador e a senha do primeiro acesso dele (troque depois em Minha conta)
#CHRONOTRADE_ADMIN_EMAIL=marcelomekaro@gmail.com
#CHRONOTRADE_ADMIN_SENHA=
# Domínio para o HTTPS automático (docker compose --profile https up -d chronotrade agente caddy)
#CHRONOTRADE_DOMINIO=chronotrade.seudominio.com.br
# Liga o modo demonstração ao abrir o app (dados fictícios)
#CHRONOTRADE_DEMO=0

# Pagamento com liberação automática (PIX do Mercado Pago). Sem ele, o app usa a sua chave PIX e você libera à mão.
#MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Agente Sentinela: de quantos em quantos minutos ele roda, e se liga junto com o app (1) ou não (0)
#CHRONOTRADE_AGENTE_MINUTOS=60
#CHRONOTRADE_AGENTE_AUTOMATICO=1
# No modo pessoal: e-mail para receber as dicas (precisa do SMTP abaixo)
#CHRONOTRADE_AVISO_EMAIL=

# E-mail dos avisos (Gmail: smtp.gmail.com, porta 587, e uma "senha de app" da sua conta Google)
#CHRONOTRADE_SMTP_HOST=smtp.gmail.com
#CHRONOTRADE_SMTP_PORTA=587
#CHRONOTRADE_SMTP_USUARIO=marcelomekaro@gmail.com
#CHRONOTRADE_SMTP_SENHA=
#CHRONOTRADE_SMTP_REMETENTE=Chrono Trade <marcelomekaro@gmail.com>

# WhatsApp dos avisos (API oficial da Meta, exige conta WhatsApp Business)
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=
#WHATSAPP_MODELO=
#WHATSAPP_IDIOMA=pt_BR

# Corretora real pelo MetaTrader 5 (só no seu computador Windows): libera o envio de ordens reais
#CHRONOTRADE_PERMITIR_ORDENS_REAIS=0

# Profit (Nelogica) pela ProfitDLL, licença à parte da Nelogica (só no Windows). Opcional: dá para digitar na tela.
#PROFIT_DLL=C:\Nelogica\ProfitDLL64.dll
#PROFIT_CHAVE=
#PROFIT_USUARIO=
#PROFIT_SENHA=

# Conector do PC (versão online): endereço público do app e porta da API
#CHRONOTRADE_URL=https://chronotrade.seudominio.com.br
#CHRONOTRADE_API_PORTA=8502

# Jarvis: comando de voz com o OpenJarvis rodando no seu PC (jarvis serve --port 8000)
#OPENJARVIS_URL=http://localhost:8000
#OPENJARVIS_API_KEY=
#OPENJARVIS_MODELO=
# Plano B da voz sem OpenJarvis: o Gemini transcreve (usa a GOOGLE_API_KEY acima)
#CHRONOTRADE_MODELO_VOZ=gemini-2.5-flash
# Voz local do Jarvis, sem OpenJarvis (pip install -e ".[voz]", chronotrade-voz baixar, chronotrade-voz)
#CHRONOTRADE_VOZ=jeff
#CHRONOTRADE_VOZ_WHISPER=small

# Avisos pelo Telegram (grátis): crie o bot com @BotFather
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_BOT_USUARIO=nome_do_seu_bot
